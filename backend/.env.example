# ==========================================
# Backend Environment Variables (.env.example)
# Copy this file to .env and configure for your environment
# ==========================================

# Application Environment
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS Allowed Origins
# Comma-separated list of allowed frontend origins (e.g. your Vercel domain and local test URLs)
# Set to "*" during initial setup to allow all origins
ALLOWED_ORIGINS=https://your-portfolio.vercel.app,http://192.168.1.5:5173

# MySQL Database Configuration
# Provide either individual DB parameters or a full DATABASE_URL
DB_HOST=your_mysql_host.example.com
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=portfolio_db
# Optional complete connection string (PyMySQL driver):
# DATABASE_URL=mysql+pymysql://your_user:your_password@your_mysql_host.example.com:3306/portfolio_db

# Admin & JWT Security Configuration
# Generate a random 64-character secret key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_random_secure_hex_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_secure_admin_password

# SMTP Email Notification Settings
# When SMTP_ENABLED=true, new contact messages and inquiries send email notifications
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password_here
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_TO_EMAIL=pathakanuj322@gmail.com
SMTP_TLS=true
