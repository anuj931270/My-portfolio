# ==========================================
# Frontend Environment Variables (.env.example)
# ==========================================

# Production: URL of your deployed FastAPI backend (e.g. on Render, Railway, or AWS)
# Example: https://portfolio-backend.onrender.com
VITE_API_URL=https://your-backend-api.onrender.com

# Local development backend port (fallback when VITE_API_URL is unset)
VITE_API_PORT=8000
